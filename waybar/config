{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 5,

    "modules-left": ["custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5"],
    "modules-center": ["clock"],
    "modules-right": ["custom/mediaplayer", "wireplumber", "idle_inhibitor", "network", "tray"],

    "custom/ws1": {
        "exec": "~/.config/waybar/workspace.sh 1",
        "return-type": "json",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = 1})'",
        "tooltip": false
    },

    "custom/ws2": {
        "exec": "~/.config/waybar/workspace.sh 2",
        "return-type": "json",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = 2})'",
        "tooltip": false
    },

    "custom/ws3": {
        "exec": "~/.config/waybar/workspace.sh 3",
        "return-type": "json",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = 3})'",
        "tooltip": false
    },

    "custom/ws4": {
        "exec": "~/.config/waybar/workspace.sh 4",
        "return-type": "json",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = 4})'",
        "tooltip": false
    },

    "custom/ws5": {
        "exec": "~/.config/waybar/workspace.sh 5",
        "return-type": "json",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = 5})'",
        "tooltip": false
    },

    "clock": {
        "format": "{:%d.%m.%Y | %H:%M}",
        "tooltip": false
    },

    "wireplumber": {
        "format": "\udb81\udd7e  {volume}%",
        "format-muted": "\udb81\udd81  {volume}%",
        "max-volume": 100,
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "battery": {
        "bat": "BAT1",
        "interval": 60,
        "format": "{icon}  {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
    },

    "memory": {
        "interval": 30,
        "format": "\uf4bc  {used:0.1f}G"
    },

    "network": {
        "format": "",
        "format-ethernet": "\udb83\udc9d",
        "format-wifi": "{icon}",
        "format-disconnected": "\udb83\udc9c",
        "format-icons": ["\udb82\udd2f", "\udb82\udd1f", "\udb82\udd22", "\udb82\udd25", "\udb82\udd28"],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "Disconnected",
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "\udb80\udd76",
            "deactivated": "\udb83\udfaa"
        }
    },

    "custom/mediaplayer": {
        "exec": "~/.config/waybar/mediaplayer.sh",
        "interval": 1,
        "format": "{}",
        "on-click": "playerctl play-pause"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    }
}